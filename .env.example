# Copy to .env and fill in. .env is gitignored -- never commit the real one.

# "grafana" (needs a token) or "prometheus" (needs VPN / in-cluster access)
METRICS_BACKEND=prometheus

# Only required when METRICS_BACKEND=grafana
GRAFANA_URL=https://grafana-mardi.zib.de
GRAFANA_TOKEN=
GRAFANA_DATASOURCE_UID=prometheus

# Only used when METRICS_BACKEND=prometheus
PROMETHEUS_URL=https://prometheus-mardi.zib.de

SPARQL_URL=https://query.portal.mardi4nfdi.de/sparql
CACHE_TTL_SECONDS=30
QUERY_TIMEOUT_SECONDS=10
EDIT_WINDOW_DAYS=7
